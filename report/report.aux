\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Bland-Altman agreement with the original MATLAB fit, whole brain (180,722 voxels): difference against mean for $D$ (left column) and $\beta $ (right column), for the Ceres port, the best sequential version and CUDA. Solid line: bias; dashed: 95\% limits of agreement. Almost all voxels lie in the thin band at zero. The diagonal lines are voxels where one method placed $\beta $ (or $D$) on a bound: if one value is 0, the point must lie on difference $= \pm 2 \times $ mean, and if one is 1, on difference $= \pm (2 - 2 \times $ mean$)$. These are poorly determined voxels (see text).}}{11}{figure.caption.35}\protected@file@percent }
\newlabel{fig:ba}{{2}{11}{Bland-Altman agreement with the original MATLAB fit, whole brain (180,722 voxels): difference against mean for $D$ (left column) and $\beta $ (right column), for the Ceres port, the best sequential version and CUDA. Solid line: bias; dashed: 95\% limits of agreement. Almost all voxels lie in the thin band at zero. The diagonal lines are voxels where one method placed $\beta $ (or $D$) on a bound: if one value is 0, the point must lie on difference $= \pm 2 \times $ mean, and if one is 1, on difference $= \pm (2 - 2 \times $ mean$)$. These are poorly determined voxels (see text)}{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Slice 73. Left: original MATLAB maps. Right: differences between versions (blue lower, red higher, grey equal). OpenMP and CUDA are indistinguishable from the best sequential version.}}{11}{figure.caption.36}\protected@file@percent }
\newlabel{fig:maps}{{3}{11}{Slice 73. Left: original MATLAB maps. Right: differences between versions (blue lower, red higher, grey equal). OpenMP and CUDA are indistinguishable from the best sequential version}{figure.caption.36}{}}
